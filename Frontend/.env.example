# =========================================================
# MYC PERFUMES - VARIABLES DEL FRONTEND
# Copia este archivo como .env.local (desarrollo) o configúralas
# directamente en Cloudflare Pages > Settings > Environment variables.
# Solo las variables que empiezan con VITE_ llegan al navegador.
# Nunca pongas aquí secretos, tokens de Supabase ni service_role.
# =========================================================

# Desarrollo: usa el proxy de Vite hacia http://127.0.0.1:8000.
VITE_API_URL=/api/v1

# Producción (Cloudflare Pages): URL pública completa del backend.
# Ejemplo:
# VITE_API_URL=https://TU-BACKEND.onrender.com/api/v1

# ---------------------------------------------------------
# FIREBASE CLOUD MESSAGING (CONFIGURACIÓN PÚBLICA)
# ---------------------------------------------------------
# Estos valores son públicos por diseño de Firebase. NO coloques aquí
# la cuenta de servicio JSON ni su versión Base64: esas credenciales
# son privadas y pertenecen únicamente al backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
