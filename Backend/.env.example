# =========================================================
# MYC PERFUMES - VARIABLES DEL BACKEND
# Copia este archivo como .env y completa los valores reales.
# Nunca subas el .env real al repositorio.
# =========================================================

# ---------------------------------------------------------
# DJANGO / ENTORNO
# ---------------------------------------------------------
SECRET_KEY=pon_aqui_tu_secret_key_larga_y_aleatoria
DEBUG=True
IS_PRODUCTION=False

# Hosts permitidos, separados por coma, sin esquema.
# Producción (Render): myc-perfumes-api.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend autorizados para llamar la API.
# Incluye el dominio de Cloudflare Pages y, si aplica, tu dominio propio.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Orígenes de confianza para formularios/admin con CSRF (con esquema).
# Incluye el dominio del backend y el del frontend.
# Producción: https://myc-perfumes-api.onrender.com,https://mi-sitio.pages.dev
CSRF_TRUSTED_ORIGINS=

# Nivel de logs (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# Token interno del webhook genérico del proyecto.
WEBHOOK_TOKEN=pon_aqui_tu_webhook_token

# ---------------------------------------------------------
# BASE DE DATOS
# ---------------------------------------------------------
# Opción recomendada en producción: cadena de conexión de Supabase.
# Usa el Session Pooler (puerto 5432) o la conexión directa.
# Formato del Session Pooler:
# postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Exigir SSL en la conexión PostgreSQL. Debe ser True en producción.
DB_SSL_REQUIRE=False

# Segundos de reutilización de conexiones.
# Session Pooler / conexión directa: 600. Transaction Pooler (6543): 0.
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True

# Conexión local por variables separadas (compatibilidad).
# Si DATABASE_URL está vacío y DB_NAME tiene valor, se usa esta bloque.
DB_NAME=myc_db
DB_USER=postgres
DB_PASSWORD=pon_aqui_tu_password_local
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------------------------------------------------------
# SUPABASE STORAGE (COMPATIBLE CON S3)
# ---------------------------------------------------------
# En desarrollo puede quedar False para guardar en Backend/media/.
# En producción debe ser True.
USE_SUPABASE_STORAGE=False

# Datos del proyecto de Supabase.
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=productos

# Endpoint S3 de Supabase:
# https://TU_PROJECT_REF.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=

# Región del proyecto de Supabase (por ejemplo us-east-1).
SUPABASE_S3_REGION=sa-east-1

# Credenciales S3 creadas en Supabase > Storage > S3 access keys.
# No uses la service_role key del frontend.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# URL pública base del bucket. Si se deja vacía se construye con
# SUPABASE_URL + /storage/v1/object/public/ + SUPABASE_STORAGE_BUCKET.
# Requiere que el bucket sea público.
SUPABASE_STORAGE_PUBLIC_URL=

# False para bucket público (catálogo). True solo si se usan URLs firmadas.
SUPABASE_STORAGE_QUERYSTRING_AUTH=False

# Tamaño máximo (bytes) que se mantiene en memoria durante la subida.
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

# ---------------------------------------------------------
# SEGURIDAD ADICIONAL EN PRODUCCIÓN
# ---------------------------------------------------------
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------
# CORREO ELECTRÓNICO
# ---------------------------------------------------------
# En desarrollo se puede usar:
# django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MYC Perfumes <no-reply@mycperfumes.com>
EMAIL_TIMEOUT=10
